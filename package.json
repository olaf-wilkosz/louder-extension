{
  "name": "louder-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Louder: a distraction-free text-to-speech reader for the browser with live word and sentence highlighting (Manifest V3, TypeScript + esbuild).",
  "author": "Olaf Wilkosz",
  "license": "MIT",
  "homepage": "https://olaf-wilkosz.github.io/louder-extension/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olaf-wilkosz/louder-extension.git"
  },
  "bugs": {
    "url": "https://github.com/olaf-wilkosz/louder-extension/issues"
  },
  "keywords": [
    "text-to-speech",
    "tts",
    "browser-extension",
    "chrome-extension",
    "manifest-v3",
    "accessibility"
  ],
  "scripts": {
    "build": "node build.js",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "devDependencies": {
    "@mozilla/readability": "^0.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.1.40",
    "esbuild": "^0.28.0",
    "jsdom": "^31.0.0",
    "typescript": "^6.0.3"
  }
}
