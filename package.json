{
  "name": "louder-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Louder: a distraction-free text-to-speech reader for the browser with live word and sentence highlighting (Manifest V3, TypeScript + esbuild).",
  "author": "Olaf Wilkosz",
  "license": "MIT",
  "homepage": "https://olaf-wilkosz.github.io/louder-extension/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olaf-wilkosz/louder-extension.git"
  },
  "bugs": {
    "url": "https://github.com/olaf-wilkosz/louder-extension/issues"
  },
  "keywords": [
    "text-to-speech",
    "tts",
    "browser-extension",
    "chrome-extension",
    "manifest-v3",
    "accessibility"
  ],
  "scripts": {
    "build": "node scripts/build.mjs chrome",
    "dev": "node scripts/build.mjs chrome --watch",
    "dev:firefox": "node scripts/build.mjs firefox --watch",
    "build:firefox": "node scripts/build.mjs firefox",
    "package": "node scripts/build.mjs all --zip",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-release.mjs",
    "site": "node scripts/build-site.mjs",
    "site:serve": "node scripts/serve.mjs",
    "audit:site": "node scripts/audit-site.mjs",
    "render": "node scripts/render-store.mjs"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "devDependencies": {
    "@mozilla/readability": "^0.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.1.40",
    "chrome-launcher": "1.2.3",
    "esbuild": "^0.28.0",
    "fflate": "^0.8.3",
    "jsdom": "^31.0.0",
    "lighthouse": "13.6.0",
    "puppeteer-core": "25.17.0",
    "sharp": "0.35.5",
    "typescript": "^6.0.3"
  }
}
